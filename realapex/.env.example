# ============================================================
# RealApex ($APEX) Presale Ecosystem — Environment Variables
# Copy to `.env.local` and fill in real values.
# ============================================================

# ---- Supabase (Database & Auth) ----
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only. NEVER expose to the client. Used by admin API routes & middleware.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Web3 / WalletConnect ----
# Get a projectId at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"
# Chain the presale runs on: 1 = Ethereum Mainnet, 11155111 = Sepolia
NEXT_PUBLIC_CHAIN_ID="1"
# Optional custom RPC (falls back to public RPC if omitted)
NEXT_PUBLIC_RPC_URL=""

# ---- Presale on-chain config (public, safe to expose) ----
NEXT_PUBLIC_APEX_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_USDT_TOKEN_ADDRESS="0xdAC17F958D2ee523a2206206994597C13D831ec7"

# ---- Admin access control ----
# Comma-separated lowercase wallet addresses granted admin access.
ADMIN_WALLET_ADDRESSES="0xyouradminwallet1,0xyouradminwallet2"
# Comma-separated admin emails (Supabase Auth) granted admin access.
ADMIN_EMAILS="admin@realapex.io"

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Secret used to hash visitor IPs in analytics (any long random string).
ANALYTICS_IP_SALT="change-me-to-a-long-random-string"
